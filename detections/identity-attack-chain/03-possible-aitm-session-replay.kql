// Stage 3 — Possible AiTM session-cookie replay
// ATT&CK: T1539 (Steal Web Session Cookie)
//         T1550.004 (Use Alternate Authentication Material: Web Session Cookie)
// Data source: SigninLogs
// Important: impossible travel is a behavioral proxy; it does not prove AiTM.

let Lookback = 1d;
let ReplayWindow = 60m;
let AllowedCountryPairs = dynamic([
    // Exact lowercase pairs, for example: "gb|ie"
]);
let SuccessfulSignins =
    SigninLogs
    | where TimeGenerated >= ago(Lookback)
    | where tostring(ResultType) == "0"
    | extend
        UserPrincipalName = tolower(UserPrincipalName),
        Country = tolower(tostring(LocationDetails.countryOrRegion)),
        City = tostring(LocationDetails.city),
        DeviceId = tostring(DeviceDetail.deviceId),
        Browser = tostring(DeviceDetail.browser),
        OperatingSystem = tostring(DeviceDetail.operatingSystem)
    | where isnotempty(UserPrincipalName)
    | where isnotempty(Country)
    | project
        TimeGenerated,
        UserPrincipalName,
        IPAddress,
        Country,
        City,
        DeviceId,
        Browser,
        OperatingSystem,
        AppDisplayName,
        UserAgent,
        AuthenticationRequirement,
        ConditionalAccessStatus;
let EarlierSignins =
    SuccessfulSignins
    | project
        UserPrincipalName,
        FirstTime = TimeGenerated,
        FirstIP = IPAddress,
        FirstCountry = Country,
        FirstCity = City,
        FirstDeviceId = DeviceId,
        FirstBrowser = Browser,
        FirstOS = OperatingSystem,
        FirstUserAgent = UserAgent,
        FirstAuthRequirement = AuthenticationRequirement,
        FirstCAStatus = ConditionalAccessStatus,
        AppDisplayName;
let LaterSignins =
    SuccessfulSignins
    | project
        UserPrincipalName,
        SecondTime = TimeGenerated,
        SecondIP = IPAddress,
        SecondCountry = Country,
        SecondCity = City,
        SecondDeviceId = DeviceId,
        SecondBrowser = Browser,
        SecondOS = OperatingSystem,
        SecondUserAgent = UserAgent,
        SecondAuthRequirement = AuthenticationRequirement,
        SecondCAStatus = ConditionalAccessStatus;
EarlierSignins
| join kind=inner LaterSignins on UserPrincipalName
| where SecondTime between ((FirstTime + 1s) .. (FirstTime + ReplayWindow))
| where FirstIP != SecondIP
| where FirstCountry != SecondCountry
| extend CountryPair = strcat(FirstCountry, "|", SecondCountry)
| where array_index_of(AllowedCountryPairs, CountryPair) == -1
| extend MinutesApart = datetime_diff("minute", SecondTime, FirstTime)
| project
    UserPrincipalName,
    FirstTime,
    SecondTime,
    MinutesApart,
    FirstIP,
    SecondIP,
    FirstCountry,
    SecondCountry,
    FirstCity,
    SecondCity,
    FirstDeviceId,
    SecondDeviceId,
    FirstBrowser,
    SecondBrowser,
    FirstOS,
    SecondOS,
    FirstAuthRequirement,
    SecondAuthRequirement,
    FirstCAStatus,
    SecondCAStatus,
    AppDisplayName,
    FirstUserAgent,
    SecondUserAgent
| order by SecondTime desc
