// Stage 2 — Successful sign-in shortly after a malicious URL click
// ATT&CK: T1056.003 (Input Capture: Web Portal Capture)
//         T1078.004 (Valid Accounts: Cloud Accounts)
// Data sources: UrlClickEvents, SigninLogs
// Prerequisite: Defender for Office 365 plus Entra sign-in logs
// Important: this detects subsequent account use, not credential capture itself.

let Lookback = 1d;
let ClickToSigninWindow = 30m;
let SuspiciousClicks =
    UrlClickEvents
    | where Timestamp >= ago(Lookback)
    | where isnotempty(AccountUpn)
    | where ThreatTypes has_any ("Phish", "Malware")
    | project
        ClickTime = Timestamp,
        UserPrincipalName = tolower(AccountUpn),
        Url,
        ThreatTypes,
        ClickAction = ActionType,
        IsClickedThrough;
let SuccessfulSignins =
    SigninLogs
    | where TimeGenerated >= ago(Lookback)
    | where tostring(ResultType) == "0"
    | extend UserPrincipalName = tolower(UserPrincipalName)
    | project
        SigninTime = TimeGenerated,
        UserPrincipalName,
        IPAddress,
        Country = tostring(LocationDetails.countryOrRegion),
        City = tostring(LocationDetails.city),
        AppDisplayName,
        UserAgent,
        AuthenticationRequirement,
        ConditionalAccessStatus;
SuspiciousClicks
| join kind=inner SuccessfulSignins on UserPrincipalName
| where SigninTime between (ClickTime .. (ClickTime + ClickToSigninWindow))
| extend MinutesAfterClick = datetime_diff("minute", SigninTime, ClickTime)
| project
    ClickTime,
    SigninTime,
    MinutesAfterClick,
    UserPrincipalName,
    Url,
    ThreatTypes,
    ClickAction,
    IsClickedThrough,
    IPAddress,
    Country,
    City,
    AppDisplayName,
    UserAgent,
    AuthenticationRequirement,
    ConditionalAccessStatus
| order by SigninTime desc
